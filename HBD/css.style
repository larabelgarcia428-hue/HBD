```css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;

    font-family: "Georgia", serif;
    color: white;

    background:
        linear-gradient(
            135deg,
            #12001f,
            #3b0066,
            #ff4d88
        );
}


/* =========================
   BIRTHDAY CARD
========================= */

.card {
    position: relative;

    width: 90%;
    max-width: 600px;

    padding: 50px 30px;

    text-align: center;

    background: rgba(255, 255, 255, 0.12);

    border: 2px solid rgba(255, 255, 255, 0.3);

    border-radius: 30px;

    backdrop-filter: blur(12px);

    box-shadow:
        0 0 40px rgba(255, 105, 180, 0.6);

    z-index: 10;

    animation: appear 1.5s ease;
}


/* Card Entrance */

@keyframes appear {

    from {
        opacity: 0;
        transform: scale(0.7);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

}


/* =========================
   TITLE
========================= */

h1 {

    font-size: 48px;

    margin-bottom: 20px;

    color: white;

    text-shadow:
        0 0 10px #ff69b4,
        0 0 25px #ff1493,
        0 0 40px #ff69b4;

    animation: glow 2s infinite alternate;
}


@keyframes glow {

    from {
        text-shadow:
            0 0 10px #ff69b4;
    }

    to {
        text-shadow:
            0 0 20px #ff69b4,
            0 0 40px #ff1493;
    }

}


/* =========================
   CAKE
========================= */

.cake {

    font-size: 80px;

    margin: 15px;

    animation: bounce 1.5s infinite;
}


@keyframes bounce {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }

}


/* =========================
   NAME
========================= */

.name {

    font-size: 32px;

    font-weight: bold;

    color: #ffd1e8;

    text-shadow:
        0 0 15px #ff69b4;
}


/* =========================
   MESSAGE
========================= */

.message {

    font-size: 20px;

    line-height: 1.7;

    margin: 20px auto;

    max-width: 480px;
}


/* =========================
   BUTTON
========================= */

button {

    margin-top: 20px;

    padding: 14px 30px;

    border: none;

    border-radius: 30px;

    background: #ff4f9a;

    color: white;

    font-size: 18px;

    cursor: pointer;

    box-shadow:
        0 0 20px #ff4f9a;

    transition: 0.3s;
}


button:hover {

    transform: scale(1.1);

    background: #ff1493;

}


/* =========================
   FLOATING HEARTS
========================= */

.heart {

    position: absolute;

    bottom: -50px;

    font-size: 25px;

    animation:
        float 8s linear infinite;

    opacity: 0.8;
}


.heart:nth-child(1) {
    left: 10%;
    animation-delay: 1s;
}

.heart:nth-child(2) {
    left: 25%;
    animation-delay: 3s;
}

.heart:nth-child(3) {
    left: 45%;
    animation-delay: 5s;
}

.heart:nth-child(4) {
    left: 65%;
    animation-delay: 2s;
}

.heart:nth-child(5) {
    left: 85%;
    animation-delay: 4s;
}


@keyframes float {

    0% {
        transform:
            translateY(0)
            rotate(0deg);

        opacity: 0;
    }

    20% {
        opacity: 1;
    }

    100% {
        transform:
            translateY(-110vh)
            rotate(360deg);

        opacity: 0;
    }

}


/* =========================
   BALLOONS
========================= */

.balloon {

    position: absolute;

    font-size: 60px;

    animation:
        balloonFloat 4s ease-in-out infinite;
}


.balloon.left {

    left: 5%;

    top: 15%;
}


.balloon.right {

    right: 5%;

    top: 20%;

    animation-delay: 1s;
}


@keyframes balloonFloat {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-25px);
    }

}


/* =========================
   SPARKLES
========================= */

.sparkle {

    position: absolute;

    color: white;

    animation:
        sparkle 2s infinite;
}


.sparkle1 {
    top: 10%;
    left: 20%;
}

.sparkle2 {
    top: 25%;
    right: 20%;
}

.sparkle3 {
    bottom: 15%;
    left: 15%;
}

.sparkle4 {
    bottom: 20%;
    right: 15%;
}


@keyframes sparkle {

    0%, 100% {

        opacity: 0;

        transform:
            scale(0.5);
    }

    50% {

        opacity: 1;

        transform:
            scale(1.5);
    }

}
```
